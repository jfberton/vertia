# InvenTrack v2 - Variables de Entorno Supabase
# Obtén estos valores desde tu panel de Supabase: Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui

# Clave de servicio para tareas administrativas del Super Admin (opcional, no exponer en el frontend)
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-aqui

# URL de la aplicación (para redirecciones de autenticación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
